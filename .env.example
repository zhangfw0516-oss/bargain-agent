# Copy to .env and fill in. Never commit .env.

# --- LLM (OpenAI-compatible endpoint, e.g. DeepSeek) --------------------------
LLM_API_KEY=your_api_key_here
LLM_API_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=30
# Optional per-agent overrides: LLM_MODEL_<AGENT>, LLM_API_BASE_URL_<AGENT>,
# LLM_API_KEY_<AGENT>. Agents: UNDERSTAND, REWRITE, SELECT, DESCRIBE,
# TASK_PARSER, PRICE_EXTRACTOR, OFFER_VERIFIER, DEAL_SUMMARY.
# LLM_MODEL_SELECT=a-stronger-model

# --- Google Shopping via SerpApi (required for Find and product monitoring) ---
SERPAPI_API_KEY=
SERPAPI_TIMEOUT=20
SERPAPI_GL=nz
SERPAPI_HL=en
SERPAPI_GOOGLE_DOMAIN=google.co.nz
SERPAPI_LOCATION=New Zealand
# Local daily cap on billable SerpApi calls (find + preview + checks).
SERPAPI_DAILY_MAX_CALLS=20

# --- Page extractors for pasted product URLs (at least one) -------------------
TAVILY_API_KEY=
TAVILY_TIMEOUT=20
FIRECRAWL_API_KEY=
FIRECRAWL_TIMEOUT=30
# Order of the fallback chain.
PAGE_EXTRACTORS=tavily,firecrawl
# Run the Firecrawl supplementary search when SerpApi returns fewer results.
SUPPLEMENT_MIN_RESULTS=5

# --- Find pipeline limits -----------------------------------------------------
FIND_MAX_QUERIES=3
FIND_DEADLINE_SECONDS=120
FIND_MAX_RECOMMENDATIONS=8

# --- Monitoring ---------------------------------------------------------------
# Minimum interval for Google Shopping product tasks (each check costs a SerpApi call).
MONITOR_MIN_FREQUENCY_MINUTES=360
MONITOR_MAX_OFFERS=20
# Comma-separated merchant names or domains; empty uses the built-in NZ list.
TRUSTED_MERCHANTS=
# true: only trusted merchants trigger an email. false: any merchant can.
ALERT_TRUSTED_ONLY=true
# Let the offer-verifier agent veto wrong-model/bundle/second-hand offers.
LLM_OFFER_VERIFY=true

# --- Email --------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=your_email@gmail.com
SMTP_TIMEOUT=10
# Total send attempts per deal episode (0 disables sending).
NOTIFICATION_MAX_RETRIES=3
DEFAULT_NOTIFY_EMAIL=your_email@gmail.com
# Start each alert email with a short AI summary (falls back to the template).
LLM_EMAIL_SUMMARY=false

# --- Storage ------------------------------------------------------------------
DATABASE_URL=sqlite:///bargain_agent.db

# ===================================================================
# Bargain Agent - Environment Configuration Template
# ===================================================================
# This file serves as a template for local environment setup.
# 1. Copy this file to a new file named `.env` in the same directory.
# 2. Fill in your personal credentials in the `.env` file.
# 3. NEVER commit the real `.env` file to GitHub (it is ignored by default).
# ===================================================================

# -------------------------------------------------------------------
# Section 1: LLM Configuration (Owner: Member 5 - Agent Core)
# -------------------------------------------------------------------
# Used by the Agent to parse natural language instructions into structured data.
# Currently configured for Google Gemini (Free Tier).

# Your Google AI Studio API Key (starts with AIza... or similar)
LLM_API_KEY="PASTE_YOUR_GEMINI_API_KEY_HERE"

# Endpoint for OpenAI-compatible API (Do not change unless switching providers)
LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"

# Model identifier (Gemini 2.5 Flash is recommended for speed and cost)
LLM_MODEL="models/gemini-2.5-flash"

# -------------------------------------------------------------------
# Section 2: Monitoring Configuration (Owner: Member 5 - Agent Core)
# -------------------------------------------------------------------
# Controls the frequency of price checks.

# Interval between monitoring cycles in MINUTES.
# For quick demos/dev: set to 0.05 (checks every 3 seconds)
# For actual usage: set to 10 (checks every 10 minutes)
CHECK_INTERVAL_MINUTES=0.05

# -------------------------------------------------------------------
# Section 3: Notification Configuration (Owner: Member 1 - Email/SMS)
# -------------------------------------------------------------------
# Placeholder for future integration of email or SMS alerts.
# Uncomment and fill in once the notification module is ready.

# SMTP_SERVER="smtp.gmail.com"
# SMTP_PORT=587
# SENDER_EMAIL="your_email@gmail.com"
# SENDER_APP_PASSWORD="your_email_app_password"
# RECEIVER_EMAIL="receiver@example.com"

# -------------------------------------------------------------------
# Section 4: Web Scraping Configuration (Owner: Member 4 - Scraper)
# -------------------------------------------------------------------
# Placeholder for headers and configurations needed for web scraping.

# User-Agent string to mimic a real browser (helps avoid being blocked)
# USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"

# -------------------------------------------------------------------
# Section 5: Debug Settings
# -------------------------------------------------------------------
# Set to True for verbose logging during development.
# Set to False for clean production logs.
DEBUG=True

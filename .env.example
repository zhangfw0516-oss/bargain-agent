# LLM API (OpenAI-compatible, e.g. DeepSeek)
LLM_API_KEY=your_api_key_here
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=30.0

# SMTP Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=your_email@gmail.com
SMTP_TIMEOUT=10.0
NOTIFICATION_MAX_RETRIES=3

# Default notification email used by CLI when --email is omitted
DEFAULT_NOTIFY_EMAIL=your_email@gmail.com

# Scraping
# Shops the agent may visit. This is the supported-shop boundary, not a crawl scope:
# each domain here needs an adapter in retailers/. Stage B supports PB Tech, Mighty Ape
# and JB Hi-Fi NZ; a shop not listed here will be reported as "not searched".
# Mighty Ape's site refuses automated requests (HTTP 403 from DataDome), so listing it
# makes that failure visible rather than hiding the shop.
SCRAPER_ALLOWED_DOMAINS=pbtech.co.nz,mightyape.co.nz,jbhifi.co.nz
SCRAPER_TIMEOUT=15.0
SCRAPER_MAX_RESPONSE_BYTES=10000000

# Database
DATABASE_URL=sqlite:///bargain_agent.db

# Optional AI enhancements
# LLM_EMAIL_SUMMARY=true makes each price-alert email start with a short
# natural-language summary of the best offer and any failed/unknown sources.
# Off by default (deterministic template); a summary failure always falls back.
LLM_EMAIL_SUMMARY=false
# LLM_EXPLAIN_RESULTS=true adds a plain-English explanation under each
# needs-confirmation and unavailable search-result row. Off by default;
# a failure always falls back to the deterministic reasons.
LLM_EXPLAIN_RESULTS=false
# LLM_MATCH_ASSIST=true lets the LLM judge colour/accessory matches when
# the hardcoded rules cannot decide. Off by default; deterministic rules stay
# the primary path and failures always fall back to them.
LLM_MATCH_ASSIST=false
# LLM_QUERY_EXPANSION=true lets the LLM expand the search query into Brave
# variants (English/brand/model), improving recall. Off by default.
LLM_QUERY_EXPANSION=false
# LLM_CANDIDATE_RANKING=true lets the LLM re-rank candidates by relevance
# before detail-fetching, so quota goes to the most likely matches. Off by default.
LLM_CANDIDATE_RANKING=false



# Optional: set to true to disable external side effects
DRY_RUN=false

# Web-search backends for broad product discovery (both optional, merged at
# runtime; whichever is configured is used, results de-duplicated by URL).
# BRAVE_SEARCH_API_KEY is supplied by your environment/secret store.
TAVILY_API_KEY=
TAVILY_SEARCH_TIMEOUT=10.0
